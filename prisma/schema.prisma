generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  price       Float
  stock       Int      @default(0)
  ageGroup    String
  coverUrl    String?
  shopierUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
}

model Order {
  id            Int      @id @default(autoincrement())
  customerName  String
  customerEmail String
  customerPhone String?
  shippingAddr  String
  totalAmount   Float
  status        String   @default("PENDING") // PENDING, PAID, SHIPPED, DELIVERED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items OrderItem[]
}

model OrderItem {
  id       Int     @id @default(autoincrement())
  orderId  Int
  bookId   Int
  quantity Int
  price    Float
  isSigned Boolean @default(false)
  signTo   String?

  order Order @relation(fields: [orderId], references: [id])
  book  Book  @relation(fields: [bookId], references: [id])
}

model Animation {
  id           Int      @id @default(autoincrement())
  title        String
  videoUrl     String
  thumbnailUrl String?
  createdAt    DateTime @default(now())
}

model Gallery {
  id        Int      @id @default(autoincrement())
  title     String?
  imageUrl  String
  createdAt DateTime @default(now())
}

model SiteSettings {
  id           String  @id @default("global")
  heroImage    String?
  heroTitle    String?
  heroSubtitle String?
  aboutText    String?
}
