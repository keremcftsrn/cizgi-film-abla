generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  ageGroup    String
  price       Float
  imageUrl    String?
  stock       Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  orderItems  OrderItem[]
}

model Order {
  id            Int      @id @default(autoincrement())
  customerName  String
  customerEmail String
  address       String
  totalAmount   Float
  status        String   @default("PENDING") // PENDING, PAID, SHIPPED
  createdAt     DateTime @default(now())
  
  // Relations
  items         OrderItem[]
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  bookId      Int
  quantity    Int      @default(1)
  isSigned    Boolean  @default(false)
  signedFor   String?  // Kime imzalanacak
  
  // Relations
  order       Order    @relation(fields: [orderId], references: [id])
  book        Book     @relation(fields: [bookId], references: [id])
}

model Animation {
  id          Int      @id @default(autoincrement())
  title       String
  channel     String
  schedule    String?
  youtubeUrl  String?
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model Gallery {
  id          Int      @id @default(autoincrement())
  title       String
  imageUrl    String
  createdAt   DateTime @default(now())
}
